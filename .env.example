# Public site URL for OAuth redirects (required on Netlify)
COMPARI5_BASE_URL=https://compari5.netlify.app

# Google Maps (Places Autocomplete + Place Details + Geocoding)
# Set this in Netlify Site settings → Environment variables (do not commit the key)
GOOGLE_MAPS_API_KEY=

# Force Netlify Blobs locally (optional; auto-on when NETLIFY=true)
# USE_NETLIFY_BLOBS=1

# Swiggy / Zepto OAuth tokens are stored once on the server (shared for all visitors).

# Blinkit on Netlify: Impit proxy (prefer Render — see services/blinkit-proxy/README.md)
# BLINKIT_PROXY_URL=https://compari5.onrender.com
# BLINKIT_PROXY_SECRET=choose-a-long-random-string

# Optional FirstClub session (from order.firstclub.co.in after login)
# FIRSTCLUB_SESSION_ID=
# FIRSTCLUB_USER_ID=